{% extends "base.j2" %}
{% block content %}
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__art" aria-hidden="true">
    <svg viewBox="0 0 700 420" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Blended the wrapper from HEAD with the updated paths from the stylish-themed branch -->
      <g class="hero__motif" opacity="0.8">
        <path class="hero__ridge hero__ridge--soft" d="M0 328C82 306 141 286 192 238C254 182 320 168 398 210C472 250 546 258 700 214V420H0V328Z" fill="currentColor" fill-opacity="0.06" />
        <path class="hero__ridge" d="M0 356C86 332 138 318 188 286C250 248 322 246 390 280C462 314 530 328 700 292V420H0V356Z" fill="currentColor" fill-opacity="0.05" />
        <path class="hero__strand" d="M112 268L185 204L264 242L344 176L430 238L512 182L596 228L646 204" stroke="currentColor" stroke-width="2" />
        <path class="hero__strand hero__strand--soft" d="M98 322L188 278L266 302L350 248L434 284L520 238L606 280L660 256" stroke="currentColor" stroke-width="1" />
      </g>
    </svg>
  </div>
  
  <div class="hero__content">
    <p class="eyebrow">{{ home.eyebrow }}</p>
    <h1 id="hero-title">{{ home.title }}</h1>
    <p class="hero__summary">{{ home.summary }}</p>
    
    <div class="hero__actions">
      <a class="button button--primary" href="#research">View My Work</a>
    </div>
  </div>
</section>

<article class="markdown-content home-content">
  {{ home.body_html }}
</article>

<section class="featured-section" id="research" aria-labelledby="research-title">
  <div class="section-heading">
    <h2 id="research-title">Recent Publications</h2>
  </div>
  <div class="record-grid">
    {% for item in publications[:3] %}
      {% include "record_card.j2" %}
    {% endfor %}
  </div>
  <a class="text-link" href="publications.html">All publications <span aria-hidden="true">&rarr;</span></a>
</section>

{% if talks %}
<section class="featured-section featured-section--compact" aria-labelledby="talks-title">
  <div class="section-heading">
    <h2 id="talks-title">Recent Talks</h2>
  </div>
  <div class="record-grid">
    {% for item in talks[:2] %}
      {% include "record_card.j2" %}
    {% endfor %}
  </div>
  <a class="text-link" href="talks.html">All talks <span aria-hidden="true">&rarr;</span></a>
</section>
{% endif %}

{% if notes %}
<section class="featured-section featured-section--compact" aria-labelledby="notes-title">
  <div class="section-heading">
    <h2 id="notes-title">Notes</h2>
  </div>
  <div class="record-grid">
    {% for item in notes[:2] %}
      {% include "record_card.j2" %}
    {% endfor %}
  </div>
  <a class="text-link" href="blog.html">All notes <span aria-hidden="true">&rarr;</span></a>
</section>
{% endif %} <!-- Moved the endif here so the CV renders independently of notes -->

<section class="cv-section" id="cv" aria-labelledby="cv-title">
  <div class="section-heading">
    <h2 id="cv-title">Curriculum Vitae</h2>
  </div>

  <div class="cv-section__actions">
    <a class="button button--primary" href="{{ home.cv }}" target="_blank" rel="noopener noreferrer">
      View Full CV
    </a>
    <a class="button" href="{{ home.cv }}" download>
      Download PDF
    </a>
  </div>
</section>
{% endblock %}