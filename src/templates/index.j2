{% extends "base.j2" %}
{% block content %}
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__art" aria-hidden="true">
    <svg viewBox="0 0 700 420" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path class="hero__ridge hero__ridge--soft" d="M0 328C82 306 141 286 192 238C254 182 320 168 398 210C472 250 546 258 700 214V420H0V328Z" />
      <path class="hero__ridge" d="M0 356C86 332 138 318 188 286C250 248 322 246 390 280C462 314 530 328 700 292V420H0V356Z" />
      <path class="hero__strand" d="M112 268L185 204L264 242L344 176L430 238L512 182L596 228L646 204" />
      <path class="hero__strand hero__strand--soft" d="M98 322L188 278L266 302L350 248L434 284L520 238L606 280L660 256" />
    </svg>
  </div>
  <div class="hero__content">
    <p class="eyebrow">{{ home.eyebrow }}</p>
    <h1 id="hero-title">{{ home.title }}</h1>
    <p class="hero__summary">{{ home.summary }}</p>
    <div class="hero__actions">
      <a class="button button--solid" href="#research">View research</a>
      <a class="button" href="{{ home.cv }}" download>Download CV</a>
    </div>
    <div class="hero__terminal" aria-label="Research focus terminal">
      <div class="terminal__header" aria-hidden="true">
        <span class="terminal__dot"></span>
        <span class="terminal__dot"></span>
        <span class="terminal__dot"></span>
      </div>
      <div class="terminal__body">
        <span class="terminal__label">focus</span>
        <code>cell_state ∩ statistics ∩ computation</code>
      </div>
    </div>
    <ul class="topic-list" aria-label="Research themes">
      {% for theme in home.themes | default([]) %}<li>{{ theme }}</li>{% endfor %}
    </ul>
  </div>
</section>

<article class="markdown-content home-content">
  {{ home.body_html }}
</article>

<section class="cv-section" id="cv" aria-labelledby="cv-title">
  <div class="cv-section__inner">
    <div class="cv-section__header">
      <p class="eyebrow">Curriculum vitae</p>
      <h2 id="cv-title">CV</h2>
    </div>
    <div class="cv-section__layout">
      <div class="cv-section__viewer">
        <object class="cv-section__embed" data="{{ home.cv }}" type="application/pdf" aria-label="Nischal Bhandari CV">
          <p>Your browser does not support embedded PDFs. <a href="{{ home.cv }}">Download the CV</a>.</p>
        </object>
      </div>
      <div class="cv-section__panel">
        <p class="cv-section__summary">Research interests across computational biology, cancer genomics, single-cell analysis, and quantitative methods.</p>
        <div class="cv-section__actions">
          <a class="button button--solid" href="{{ home.cv }}" target="_blank" rel="noopener noreferrer">View full CV</a>
          <a class="button" href="{{ home.cv }}" download>Download PDF</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="featured-section" id="research" aria-labelledby="research-title">
  <div class="section-heading">
    <h2 id="research-title">Recent publications</h2>
  </div>
  <div class="record-grid">
    {% for item in publications[:3] %}{% include "record_card.j2" %}{% endfor %}
  </div>
  <a class="text-link" href="publications.html">All publications <span aria-hidden="true">→</span></a>
</section>

{% if talks %}
<section class="featured-section featured-section--compact" aria-labelledby="talks-title">
  <div class="section-heading">
    <h2 id="talks-title">Recent talks</h2>
  </div>
  <div class="record-grid">
    {% for item in talks[:2] %}{% include "record_card.j2" %}{% endfor %}
  </div>
  <a class="text-link" href="talks.html">All talks <span aria-hidden="true">→</span></a>
</section>
{% endif %}

{% if notes %}
<section class="featured-section featured-section--compact" aria-labelledby="notes-title">
  <div class="section-heading">
    <h2 id="notes-title">Notes</h2>
  </div>
  <div class="record-grid">
    {% for item in notes[:2] %}{% include "record_card.j2" %}{% endfor %}
  </div>
  <a class="text-link" href="blog.html">All notes <span aria-hidden="true">→</span></a>
</section>
{% endif %}
{% endblock %}
