  </div>
  <div class="hero__content">
    <p class="eyebrow">{{ home.eyebrow }}</p>
    <h1 id="hero-title">{{ home.title }}</h1>
    <p class="hero__summary">{{ home.summary }}</p>
    <div class="hero__actions">
      <a class="button button--solid" href="#research">View research</a>
      <a class="button" href="{{ home.cv }}" download>Download CV</a>
    </div>
    <div class="hero__terminal" aria-label="Research focus terminal">
      <div class="terminal__header" aria-hidden="true">
        <span class="terminal__dot"></span>
        <span class="terminal__dot"></span>
        <span class="terminal__dot"></span>
      </div>
      <div class="terminal__body">
        <span class="terminal__label">focus</span>
        <code>cell_state ∩ statistics ∩ computation</code>
      </div>
    </div>
    <ul class="topic-list" aria-label="Research themes">
      {% for theme in home.themes | default([]) %}<li>{{ theme }}</li>{% endfor %}
    </ul>
  </div>
</section>

<article class="markdown-content home-content">
  {{ home.body_html }}
</article>

<section class="featured-section" id="research" aria-labelledby="research-title">
  <div class="section-heading">
    <h2 id="research-title">Recent publications</h2>
  </div>
  <div class="record-grid">
    {% for item in publications[:3] %}{% include "record_card.j2" %}{% endfor %}
  </div>
  <a class="text-link" href="publications.html">All publications <span aria-hidden="true">→</span></a>
</section>

{% if talks %}
<section class="featured-section featured-section--compact" aria-labelledby="talks-title">
  <div class="section-heading">
    <h2 id="talks-title">Recent talks</h2>
  </div>
  <div class="record-grid">
    {% for item in talks[:2] %}{% include "record_card.j2" %}{% endfor %}
  </div>
  <a class="text-link" href="talks.html">All talks <span aria-hidden="true">→</span></a>
</section>
{% endif %}

{% if notes %}
<section class="featured-section featured-section--compact" aria-labelledby="notes-title">
  <div class="section-heading">
    <h2 id="notes-title">Notes</h2>
  </div>
  <div class="record-grid">
    {% for item in notes[:2] %}{% include "record_card.j2" %}{% endfor %}
  </div>
  <a class="text-link" href="blog.html">All notes <span aria-hidden="true">→</span></a>
</section>

<section class="cv-section" id="cv" aria-labelledby="cv-title">
  <div class="section-heading">
    <h2 id="cv-title">CV</h2>
  </div>

  <div class="cv-section__actions">
    <a class="button button--solid"
       href="{{ home.cv }}"
       target="_blank"
       rel="noopener noreferrer">
      View full CV
    </a>

    <a class="button"
       href="{{ home.cv }}"
       download>
      Download PDF
    </a>
  </div>
</section>
{% endif %}
{% endblock %}
