{% extends "base.j2" %}
{% block content %}
<section class="hero" aria-labelledby="hero-title">
  
  <div class="hero__content">
    <p class="eyebrow">{{ home.eyebrow }}</p>
    <h1 id="hero-title">{{ home.title }}</h1>
    <p class="hero__summary">{{ home.summary }}</p>
  </div>
</section>

<article class="markdown-content home-content">
  {{ home.body_html }}
</article>

<section class="featured-section" id="research" aria-labelledby="research-title">
  <div class="section-heading">
    <h2 id="research-title">Recent Publications</h2>
  </div>
  <div class="record-grid">
    {% for item in publications[:3] %}
      {% include "record_card.j2" %}
    {% endfor %}
  </div>
  <a class="text-link" href="publications.html">All publications <span aria-hidden="true">&rarr;</span></a>
</section>

{% if talks %}
<section class="featured-section featured-section--compact" aria-labelledby="talks-title">
  <div class="section-heading">
    <h2 id="talks-title">Recent Talks</h2>
  </div>
  <div class="record-grid">
    {% for item in talks[:2] %}
      {% include "record_card.j2" %}
    {% endfor %}
  </div>
  <a class="text-link" href="talks.html">All talks <span aria-hidden="true">&rarr;</span></a>
</section>
{% endif %}

{% if notes %}
<section class="featured-section featured-section--compact" aria-labelledby="notes-title">
  <div class="section-heading">
    <h2 id="notes-title">Notes</h2>
  </div>
  <div class="record-grid">
    {% for item in notes[:2] %}
      {% include "record_card.j2" %}
    {% endfor %}
  </div>
  <a class="text-link" href="blog.html">All notes <span aria-hidden="true">&rarr;</span></a>
</section>
{% endif %} <!-- Moved the endif here so the CV renders independently of notes -->

<section class="cv-section" id="cv" aria-labelledby="cv-title">
  <div class="section-heading">
    <h2 id="cv-title">Curriculum Vitae</h2>
  </div>

  <div class="cv-section__actions">
    <a class="button button--primary" href="{{ home.cv }}" target="_blank" rel="noopener noreferrer">
      View Full CV
    </a>
    <a class="button" href="{{ home.cv }}" download>
      Download PDF
    </a>
  </div>
</section>
{% endblock %}